+#ifdef __APPLE__
+    // There is no sync fd on macOS to export a semaphore as, so the guest's sync for it is a fence
+    // here: an empty submit waits on the semaphore and signals a fence, and the guest's export of
+    // syncId (GFXSTREAM_CREATE_EXPORT_SYNC_VK) waits on that fence instead of on an OS handle.
+    std::mutex mSemaphoreSyncMutex;
+    std::unordered_map<uint64_t, uint64_t> mSemaphoreSyncFences;  // syncId -> boxed VkFence
+
+    VkResult signalFenceForSemaphore(gfxstream::base::BumpPool* pool, VkDevice boxed_device,
+                                     VkSemaphore semaphore, uint64_t syncId) {
+        (void)semaphore;
+        auto vk = dispatch_VkDevice(boxed_device);
+        auto device = unbox_VkDevice(boxed_device);
+        // Waiting on the semaphore from a submit of our own would sit in the queue ahead of the
+        // guest's signal when that arrives later, and Metal runs a queue in order: a deadlock. So
+        // the queue is drained of what it already holds - the work the guest has submitted to
+        // signal it - and the fence handed back is signalled from the start.
+        VkQueue queue = VK_NULL_HANDLE;
+        std::shared_ptr<std::mutex> queueMutex;
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            for (auto& [unboxedQueue, queueInfo] : mQueueInfo) {
+                if (queueInfo.device == device) {
+                    queue = unboxedQueue;
+                    queueMutex = queueInfo.queueMutex;
+                    break;
+                }
+            }
+        }
+        if (queue != VK_NULL_HANDLE) {
+            std::lock_guard<std::mutex> qlock(*queueMutex);
+            vk->vkQueueWaitIdle(queue);
+        }
+        const VkFenceCreateInfo fci = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO, nullptr,
+                                       VK_FENCE_CREATE_SIGNALED_BIT};
+        VkFence boxedFence = VK_NULL_HANDLE;
+        VkResult r = on_vkCreateFence(pool, kInvalidSnapshotApiCallHandle, boxed_device, &fci,
+                                      nullptr, &boxedFence);
+        if (r != VK_SUCCESS) return r;
+        std::lock_guard<std::mutex> lock(mSemaphoreSyncMutex);
+        mSemaphoreSyncFences[syncId] = reinterpret_cast<uint64_t>(boxedFence);
+        return VK_SUCCESS;
+    }
+
+    std::optional<uint64_t> takeSemaphoreSyncFence(uint64_t syncId) {
+        std::lock_guard<std::mutex> lock(mSemaphoreSyncMutex);
+        auto it = mSemaphoreSyncFences.find(syncId);
+        if (it == mSemaphoreSyncFences.end()) return std::nullopt;
+        uint64_t fence = it->second;
+        mSemaphoreSyncFences.erase(it);
+        return fence;
+    }
+#endif
