# hukan's changes to virglrenderer 1.3.0, applied by Vendor/build-virglrenderer.sh (patch -p1).
#
# - A CLEAR_SURFACE naming a surface that does not exist failed the whole context. Mesa 25.2's virgl
#   sends exactly that (fixed in 25.3, which skips such a clear); drop it the way 25.3 would.
# - A texture buffer in an RGB32 format is bound as its one-component R32 format over the same bytes
#   and read three texels at a time. Metal has no three-component 32-bit texel buffer format on
#   GPUs before Apple family 11, so Zink on KosmicKrisp cannot honour one — it claims
#   GL_ARB_texture_buffer_object_rgb32 only because the renderer overrides it in, for the GL 4.x
#   the extension stands between — and a guest that used one aborted the renderer on a Metal
#   assertion. The guest sees the extension, and vrend never hands the host the format.
#   Which samplers hold such a view is a shader key mask, like the emulated-rectangle one;
#   texelFetch becomes three fetches and textureSize is divided by three.
diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 4bf88e0..06b5b21 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -882,6 +882,19 @@ static void vrend_finish_context_switch(struct vrend_context *ctx);
 static void vrend_patch_blend_state(struct vrend_sub_context *sub_ctx);
 static void vrend_update_frontface_state(struct vrend_sub_context *ctx);
 static void vrend_destroy_program(struct vrend_linked_shader_program *ent);
+/* A texture buffer in an RGB32 format is bound as its one-component R32 format over the same
+ * bytes, and the shader reads three texels per element: Metal, under Zink on KosmicKrisp, has no
+ * three-component 32-bit texel buffer format on GPUs before Apple family 11. */
+static GLenum vrend_tbo_rgb32_component(enum virgl_formats format)
+{
+   switch (format) {
+   case VIRGL_FORMAT_R32G32B32_FLOAT: return GL_R32F;
+   case VIRGL_FORMAT_R32G32B32_UINT: return GL_R32UI;
+   case VIRGL_FORMAT_R32G32B32_SINT: return GL_R32I;
+   default: return GL_NONE;
+   }
+}
+
 static void vrend_apply_sampler_state(struct vrend_sub_context *sub_ctx,
                                       struct vrend_resource *res,
                                       struct vrend_sampler_state *sampler_state,
@@ -3748,6 +3761,8 @@ void vrend_set_single_sampler_view(struct vrend_context *ctx,
 
          glBindTexture(GL_TEXTURE_BUFFER, view->texture->tbo_tex_id);
          internalformat = tex_conv_table[view->format].internalformat;
+         if (vrend_tbo_rgb32_component(view->format) != GL_NONE)
+            internalformat = vrend_tbo_rgb32_component(view->format);
          ctx->sub->shader_dirty = true;
 
          if (internalformat == GL_NONE ||
@@ -4324,6 +4339,10 @@ static inline void vrend_fill_shader_key(struct vrend_sub_context *sub_ctx,
          vrend_shader_sampler_views_mask_set(key->sampler_views_emulated_rect_mask, i);
       }
 
+      if (view->texture->target == GL_TEXTURE_BUFFER &&
+          vrend_tbo_rgb32_component(view->format) != GL_NONE)
+         vrend_shader_sampler_views_mask_set(key->sampler_views_tbo_rgb32_mask, i);
+
       if (view->texture->target == GL_TEXTURE_BUFFER) {
          enum pipe_swizzle swizzle[4];
          if (vrend_get_swizzle(view, swizzle)) {
@@ -4907,8 +4926,9 @@ void vrend_clear_surface(struct vrend_context *ctx, uint32_t surf_handle,
    surf = vrend_object_lookup(sub_ctx->object_hash, surf_handle,
                               VIRGL_OBJECT_SURFACE);
    if (!surf) {
-      vrend_report_context_error(ctx, VIRGL_ERROR_CTX_ILLEGAL_SURFACE,
-                                 surf_handle);
+      /* Mesa 25.2's virgl encodes clear_render_target with the handle of a surface it never
+       * created (fixed in 25.3, which skips such a clear). Drop it as 25.3 would, rather than
+       * failing the whole context over it. */
       return;
    }
 
diff --git a/src/vrend/vrend_shader.c b/src/vrend/vrend_shader.c
index 6a26fdf..0542a62 100644
--- a/src/vrend/vrend_shader.c
+++ b/src/vrend/vrend_shader.c
@@ -2861,9 +2861,11 @@ static void emit_txq(struct dump_ctx *ctx,
          writemask = wm_buffer;
       }
 
-      emit_buff(&ctx->glsl_strbufs, "%s%s = %s(textureSize(%s%s))%s;\n", dst,
+      bool rgb32 = inst->Texture.Texture == TGSI_TEXTURE_BUFFER &&
+                   vrend_shader_sampler_views_mask_get(ctx->key->sampler_views_tbo_rgb32_mask, sreg_index);
+      emit_buff(&ctx->glsl_strbufs, "%s%s = %s(textureSize(%s%s)%s)%s;\n", dst,
                 get_wm_string(twm), get_string(dtypeprefix),
-                srcs[sampler_index], bias, txq_returns_vec ? writemask : "");
+                srcs[sampler_index], bias, rgb32 ? " / 3" : "", txq_returns_vec ? writemask : "");
    }
 }
 
@@ -3450,6 +3452,19 @@ static void translate_tex(struct dump_ctx *ctx,
           * }
           *
           */
+         if (inst->Texture.Texture == TGSI_TEXTURE_BUFFER &&
+             vrend_shader_sampler_views_mask_get(ctx->key->sampler_views_tbo_rgb32_mask, sinfo->sreg_index)) {
+            const char *vec = dtypeprefix == UINT_BITS_TO_FLOAT ? "uvec4" :
+                              dtypeprefix == INT_BITS_TO_FLOAT ? "ivec4" : "vec4";
+            const char *one = dtypeprefix == UINT_BITS_TO_FLOAT ? "1u" :
+                              dtypeprefix == INT_BITS_TO_FLOAT ? "1" : "1.0";
+            emit_buff(&ctx->glsl_strbufs, "{\n  int rgb32_i = 3 * %s(%s%s);\n"
+                      "  vec4 val = %s(%s(texelFetch(%s, rgb32_i).x, texelFetch(%s, rgb32_i + 1).x,"
+                      " texelFetch(%s, rgb32_i + 2).x, %s));\n",
+                      get_string(txfi), srcs[0], src_swizzle,
+                      get_string(dtypeprefix), vec, srcs[sampler_index], srcs[sampler_index],
+                      srcs[sampler_index], one);
+         } else
          emit_buff(&ctx->glsl_strbufs, "{\n  vec4 val = %s(texelFetch%s(%s, %s(%s%s)%s%s));\n",
                    get_string(dtypeprefix),
                    tex_ext, srcs[sampler_index], get_string(txfi),
diff --git a/src/vrend/vrend_shader.h b/src/vrend/vrend_shader.h
index 7f5897b..3db8064 100644
--- a/src/vrend/vrend_shader.h
+++ b/src/vrend/vrend_shader.h
@@ -219,6 +219,8 @@ struct vrend_shader_key {
 
    uint64_t sampler_views_lower_swizzle_mask[VREND_SHADER_SAMPLER_VIEWS_MASK_LENGTH];
    uint64_t sampler_views_emulated_rect_mask[VREND_SHADER_SAMPLER_VIEWS_MASK_LENGTH];
+   /* Texture buffers whose RGB32 format the host cannot sample: bound as R32 and read three times. */
+   uint64_t sampler_views_tbo_rgb32_mask[VREND_SHADER_SAMPLER_VIEWS_MASK_LENGTH];
    uint16_t tex_swizzle[PIPE_MAX_SHADER_SAMPLER_VIEWS];
 
    uint8_t ssbo_binding_offset;
