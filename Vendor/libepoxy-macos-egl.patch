# libepoxy 1.5.10 on macOS with EGL, applied by Vendor/build-virglrenderer.sh (patch -p1).
#
# epoxy is how vrend reaches GL, and on macOS it knows only Apple's OpenGL framework: EGL is
# compiled out and every core function is looked up there. The renderer's GL is Mesa's, reached
# through Mesa's EGL beside the executable (Vendor/build-mesa.sh), so:
#
# - EGL is a platform macOS has, when the build enables it (-Degl=yes);
# - its library is Mesa's libEGL, found on the executable's run path;
# - a core function is asked of eglGetProcAddress, which Mesa answers for core functions too —
#   Apple's framework would hand back its own, which no current context of Apple's would run.
diff -ruN a/src/dispatch_common.c b/src/dispatch_common.c
--- a/src/dispatch_common.c	2022-02-17 21:56:12
+++ b/src/dispatch_common.c	2026-11-17 18:16:53
@@ -178,6 +178,8 @@
 #define OPENGL_LIB "/System/Library/Frameworks/OpenGL.framework/Versions/Current/OpenGL"
 #define GLES1_LIB "libGLESv1_CM.so"
 #define GLES2_LIB "libGLESv2.so"
+/* Mesa's, beside the executable (Vendor/build-mesa.sh) */
+#define EGL_LIB "@rpath/libEGL.1.dylib"
 #elif defined(__ANDROID__)
 #define GLX_LIB "libGLESv2.so"
 #define EGL_LIB "libEGL.so"
@@ -697,6 +699,10 @@
 void *
 epoxy_gl_dlsym(const char *name)
 {
+#if defined(__APPLE__) && PLATFORM_HAS_EGL
+    /* Mesa's EGL hands out core functions too, and Apple's framework is not what is current. */
+    return eglGetProcAddress(name);
+#endif
     epoxy_load_gl();
 
     return do_dlsym(&api.gl_handle, name, true);
diff -ruN a/src/dispatch_common.h b/src/dispatch_common.h
--- a/src/dispatch_common.h	2022-02-17 21:56:12
+++ b/src/dispatch_common.h	2026-11-17 18:16:53
@@ -28,7 +28,7 @@
 #define PLATFORM_HAS_GLX ENABLE_GLX
 #define PLATFORM_HAS_WGL 1
 #elif defined(__APPLE__)
-#define PLATFORM_HAS_EGL 0 
+#define PLATFORM_HAS_EGL ENABLE_EGL
 #define PLATFORM_HAS_GLX ENABLE_GLX
 #define PLATFORM_HAS_WGL 0
 #elif defined(ANDROID)
