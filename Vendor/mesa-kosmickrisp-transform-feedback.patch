+static bool
+gather_output_type(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   nir_alu_type *types = data;
+   if (intr->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
