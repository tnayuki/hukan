+++ b/src/kosmickrisp/vulkan/kk_buffer_view.c
@@ -20,6 +20,24 @@
 
 #include "vk_format.h"
 
+/* The R32 format whose texels an RGB32 one is made of, for a GPU whose texel buffers have no RGB32
+ * (before Apple family 11): read three at a time by the shader instead (hukan). */
+static enum pipe_format
+kk_rgb32_as_r32(const struct kk_physical_device *pdev, enum pipe_format format)
+{
+   enum pipe_format r32;
+   switch (format) {
+   case PIPE_FORMAT_R32G32B32_FLOAT: r32 = PIPE_FORMAT_R32_FLOAT; break;
+   case PIPE_FORMAT_R32G32B32_UINT: r32 = PIPE_FORMAT_R32_UINT; break;
+   case PIPE_FORMAT_R32G32B32_SINT: r32 = PIPE_FORMAT_R32_SINT; break;
+   default: return PIPE_FORMAT_NONE;
+   }
+   const struct kk_va_format *native = kk_get_va_format(format);
+   if (native && pdev->info.gpu_apple_family >= native->gpu_family)
+      return PIPE_FORMAT_NONE;
+   return r32;
+}
+
