    enum pipe_format p_format = vk_format_to_pipe_format(view->vk.format);
+   uint32_t width_px = view->vk.elements;
+   struct kk_physical_device *pdev = kk_device_physical(dev);
+   enum pipe_format r32 = kk_rgb32_as_r32(pdev, p_format);
+   view->rgb32_as_r32 = r32 != PIPE_FORMAT_NONE;
+   if (view->rgb32_as_r32) {
+      p_format = r32;
+      width_px *= 3u;
+   }
    const struct kk_va_format *supported_format = kk_get_va_format(p_format);
 
    /* If we reached here, we support reading at least */
@@ -72,12 +101,12 @@ kk_CreateBufferView(VkDevice _device, const VkBufferViewCreateInfo *pCreateInfo,
       usage |= MTL_TEXTURE_USAGE_SHADER_WRITE;
 
