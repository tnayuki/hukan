+/* An RGB32 texel buffer made as R32 (kk_texel_buffer_descriptor): which one a buffer texture is,
+ * is known only once its descriptor is read, so a fetch reads the R32 texels a texel would be
+ * made of as well and keeps them when the descriptor says so, and a size is a third of the R32
+ * texels. Both are selects rather than a branch, which this pass cannot add (hukan).
+ */
+static void
+lower_rgb32_texel_buffer(nir_builder *b, nir_tex_instr *tex, nir_def *texture,
+                         const struct lower_descriptors_ctx *ctx)
+{
+   b->cursor = nir_before_instr(&tex->instr);
+   nir_def *flag = load_resource_deref_desc(
+      b, 1, 32, nir_src_as_deref(nir_src_for_ssa(texture)),
+      offsetof(struct kk_texel_buffer_descriptor, rgb32_as_r32), ctx);
+   nir_def *rgb32 = nir_ine_imm(b, flag, 0);
+
+   b->cursor = nir_after_instr(&tex->instr);
+   nir_def *result;
+   if (tex->op == nir_texop_txs) {
+      nir_def *size = nir_channel(b, &tex->def, 0);
+      nir_def *third = nir_udiv_imm(b, size, 3);
+      result = nir_vector_insert_imm(b, &tex->def, nir_bcsel(b, rgb32, third, size), 0);
+   } else {
+      int coord_index = nir_tex_instr_src_index(tex, nir_tex_src_coord);
+      assert(coord_index >= 0);
+      nir_def *coord = tex->src[coord_index].src.ssa;
+      nir_def *first = nir_imul_imm(b, coord, 3);
+      nir_def *channels[4];
+      for (unsigned i = 0; i < 3; i++) {
+         nir_tex_instr *fetch =
+            nir_instr_as_tex(nir_instr_clone(b->shader, &tex->instr));
+         nir_builder_instr_insert(b, &fetch->instr);
+         b->cursor = nir_before_instr(&fetch->instr);
+         nir_src_rewrite(&fetch->src[coord_index].src, nir_iadd_imm(b, first, i));
+         b->cursor = nir_after_instr(&fetch->instr);
+         channels[i] = nir_channel(b, &fetch->def, 0);
+      }
+      const unsigned bits = tex->def.bit_size;
+      channels[3] = nir_alu_type_get_base_type(tex->dest_type) == nir_type_float
+                       ? nir_imm_floatN_t(b, 1.0, bits)
+                       : nir_imm_intN_t(b, 1, bits);
+      nir_def *emulated = nir_vec(b, channels, tex->def.num_components);
+      result = nir_bcsel(b, rgb32, emulated, &tex->def);
+   }
+   nir_def_rewrite_uses_after(&tex->def, result);
+   b->cursor = nir_before_instr(&tex->instr);
+}
+
