             if (gr->target == GL_TEXTURE_2D_MULTISAMPLE) {
                glTexStorage2DMultisample(gr->target, pr->nr_samples,
                                          internalformat, pr->width0, pr->height0,
diff -ruN a/src/vrend/vrend_shader.c b/src/vrend/vrend_shader.c
--- a/src/vrend/vrend_shader.c	2026-02-10 22:43:59
+++ b/src/vrend/vrend_shader.c	2026-11-15 15:40:55
@@ -6169,9 +6169,35 @@
    return true;
 }
 
+#ifdef __APPLE__
+/* macOS's OpenGL is 4.1 core and nothing else: its GLSL compiler takes #version 140 to 410 and
+ * knows almost none of the ARB extension names. Every desktop shader is therefore written as
+ * 410, and an extension that is core by then is simply left out rather than required. */
+#define APPLE_GLSL_VERSION 410
+static bool core_in_apple_glsl(const char *name)
+{
+   static const char *const core[] = {
+      "ARB_texture_rectangle", "ARB_draw_instanced", "ARB_uniform_buffer_object",
+      "ARB_fragment_coord_conventions", "ARB_texture_multisample",
+      "ARB_shader_bit_encoding", "ARB_explicit_attrib_location",
+      "ARB_texture_query_lod", "ARB_texture_gather", "ARB_sample_shading", "ARB_gpu_shader5",
+      "ARB_gpu_shader_fp64", "ARB_texture_cube_map_array", "ARB_tessellation_shader",
+      "ARB_viewport_array", "ARB_separate_shader_objects",
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(core); i++)
+      if (!strcmp(name, core[i]))
+         return true;
+   return false;
+}
+#endif
+
 static void emit_ext(struct vrend_glsl_strbufs *glsl_strbufs, const char *name,
                      const char *verb)
 {
+#ifdef __APPLE__
+   if (core_in_apple_glsl(name))
+      return;
+#endif
    emit_ver_extf(glsl_strbufs, "#extension GL_%s : %s\n", name, verb);
 }
 
